# AMOSKYS Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# IGRIS LLM — Claude API
IGRIS_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-api-key-here

# Dashboard settings
# FLASK_PORT=5003
# SECRET_KEY=generate-with-python-secrets
# LOGIN_DISABLED=true

# Local proof-of-sight. Use an absolute path; relative threat-intel stores can
# make every threat_intel_match false when a daemon starts from another CWD.
AMOSKYS_THREAT_INTEL_DB=/absolute/path/to/Amoskys_recovered/data/threat_intel.db

# Email / SMTP (for alert notifications)
AMOSKYS_EMAIL_PASSWORD=your-smtp-password
# AMOSKYS_EMAIL_HOST=smtp.gmail.com
# AMOSKYS_EMAIL_PORT=587
# AMOSKYS_EMAIL_USER=alerts@example.com

# ── Response actions (P2) ───────────────────────────────────────────────
# Both default to OFF. The console can only queue an action when the web tier
# has AMOSKYS_RESPONSE_ENABLED and the fleet backend has CC_OPERATOR_KEY set to
# the same shared secret the web tier presents. Devices authenticate with their
# own per-device keys and can never originate an action against another machine.
# AMOSKYS_RESPONSE_ENABLED=1
# CC_OPERATOR_KEY=<shared secret, web tier <-> ops>
